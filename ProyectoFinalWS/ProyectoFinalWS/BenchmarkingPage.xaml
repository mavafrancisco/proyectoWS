<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="ProyectoFinalWS.BenchmarkingPage"
             Title="Benchmarking"
             BackgroundColor="#F0F2F5">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <StackLayout BackgroundColor="#5B0000" Padding="20,25">
                <Label Text="Benchmarking"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="White"/>
                <Label Text="Análisis competitivo de mercado"
                       FontSize="13"
                       HorizontalOptions="Center"
                       TextColor="#D4B483"
                       Margin="0,4,0,0"/>
            </StackLayout>

            <VerticalStackLayout Padding="15" Spacing="12">

                
                <Border Stroke="#D4B483" BackgroundColor="White"
                        StrokeThickness="1" Padding="15"
                        StrokeShape="roundrectangle 15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Selecciona un competidor"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#5B0000"/>
                        <BoxView HeightRequest="1" Color="#E0E0E0"/>
                        <Picker x:Name="pickerCompetidor"
                                Title="-- Selecciona un competidor --"
                                SelectedIndexChanged="OnCompetidorChanged"
                                TextColor="Black"
                                BackgroundColor="#F0F2F5"/>
                    </VerticalStackLayout>
                </Border>

                
                <Border x:Name="borderComparativa"
        Stroke="#D4B483" BackgroundColor="White"
        StrokeThickness="1" Padding="15"
        StrokeShape="roundrectangle 15"
        IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Comparativa de programas"
               FontAttributes="Bold"
               FontSize="14"
               TextColor="#5B0000"/>
                        <BoxView HeightRequest="1" Color="#E0E0E0"/>
                        <Grid ColumnDefinitions="*,70,70">
                            <Label Grid.Column="0" Text="Programa"
                   FontSize="11" FontAttributes="Bold" TextColor="#888"/>
                            <Label Grid.Column="1" Text="LAMB"
                   FontSize="11" FontAttributes="Bold"
                   TextColor="#5B0000" HorizontalOptions="Center"/>
                            <Label Grid.Column="2" Text="Competidor"
                   FontSize="11" FontAttributes="Bold"
                   TextColor="#9C8442" HorizontalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#E0E0E0"/>
                        <CollectionView x:Name="colecComparativa">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,70,70" Padding="0,8">
                                        <Label Grid.Column="0"
                               Text="{Binding programa}"
                               FontSize="12" TextColor="#333"/>
                                        <Label Grid.Column="1"
                               Text="{Binding lamb}"
                               FontSize="14"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                                        <Label Grid.Column="2"
                               Text="{Binding competidor}"
                               FontSize="14"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                
                <Border x:Name="borderIndice"
                        Stroke="#9C8442" BackgroundColor="#5B0000"
                        StrokeThickness="1.5" Padding="18"
                        StrokeShape="roundrectangle 15"
                        IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Índice de competitividad"
                                   FontSize="12" TextColor="#D4B483"/>
                            <Label x:Name="lblIndice"
                                   Text="0/100"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label x:Name="lblDescripcionIndice"
                                   Text=""
                                   FontSize="11"
                                   TextColor="#D4B483"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1"
                                            VerticalOptions="Center"
                                            Spacing="4">
                            <Label x:Name="lblSemaforoIndice"
                                   Text=""
                                   FontSize="36"
                                   HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                
                <Border x:Name="borderVentajas"
                        Stroke="#9FE1CB" BackgroundColor="White"
                        StrokeThickness="1" Padding="15"
                        StrokeShape="roundrectangle 15"
                        IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="✅ Ventajas de LAMB"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#085041"/>
                        <Label Text="Lo que LAMB ofrece y el competidor no tiene"
                               FontSize="11" TextColor="#888"/>
                        <BoxView HeightRequest="1" Color="#E0E0E0"/>
                        <CollectionView x:Name="colecVentajas">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*"
                                          Padding="0,6" ColumnSpacing="10">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#EAF9EF"
                                                Stroke="Transparent"
                                                Padding="6,4"
                                                StrokeShape="roundrectangle 8">
                                            <Label Text="✅"
                                                   FontSize="14"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1"
                                                            Spacing="2"
                                                            VerticalOptions="Center">
                                            <Label Text="{Binding programa}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="#085041"/>
                                            <Label Text="{Binding detalle}"
                                                   FontSize="11"
                                                   TextColor="#888"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                
                <Border x:Name="borderBrechas"
                        Stroke="#F7C1C1" BackgroundColor="White"
                        StrokeThickness="1" Padding="15"
                        StrokeShape="roundrectangle 15"
                        IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="⚠️ Brechas de mercado"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#791F1F"/>
                        <Label Text="Lo que el competidor ofrece y LAMB no tiene"
                               FontSize="11" TextColor="#888"/>
                        <BoxView HeightRequest="1" Color="#E0E0E0"/>
                        <CollectionView x:Name="colecBrechas">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Padding="0,6" Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding programa}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="#791F1F"/>
                                                <Label Text="{Binding descripcion}"
                                                       FontSize="11"
                                                       TextColor="#888"/>
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1"
                                                    BackgroundColor="{Binding colorDemanda}"
                                                    Stroke="Transparent"
                                                    Padding="6,3"
                                                    StrokeShape="roundrectangle 10"
                                                    VerticalOptions="Start">
                                                <Label Text="{Binding demanda}"
                                                       FontSize="11"
                                                       TextColor="White"/>
                                            </Border>
                                        </Grid>
                                        <Border BackgroundColor="#FFF3F3"
                                                Stroke="Transparent"
                                                Padding="8"
                                                StrokeShape="roundrectangle 8">
                                            <Label Text="{Binding sugerencia}"
                                                   FontSize="11"
                                                   TextColor="#791F1F"/>
                                        </Border>
                                        <BoxView HeightRequest="1" Color="#F0F0F0"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                
                <Border x:Name="borderPrecios"
                        Stroke="#D4B483" BackgroundColor="White"
                        StrokeThickness="1" Padding="15"
                        StrokeShape="roundrectangle 15"
                        IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="💰 Comparativa de precios"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#5B0000"/>
                        <BoxView HeightRequest="1" Color="#E0E0E0"/>
                        <CollectionView x:Name="colecPrecios">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Padding="0,8" Spacing="6">
                                        <Label Text="{Binding programa}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#333"/>
                                        <Grid ColumnDefinitions="80,*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="LAMB"
                                                   FontSize="11"
                                                   TextColor="#5B0000"
                                                   FontAttributes="Bold"/>
                                            <ProgressBar Grid.Column="1"
                                                         Progress="{Binding progresoLamb}"
                                                         ProgressColor="#5B0000"
                                                         VerticalOptions="Center"/>
                                            <Label Grid.Column="2"
                                                   Text="{Binding precioLamb}"
                                                   FontSize="11"
                                                   TextColor="#5B0000"
                                                   FontAttributes="Bold"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="80,*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="Competidor"
                                                   FontSize="11"
                                                   TextColor="#9C8442"
                                                   FontAttributes="Bold"/>
                                            <ProgressBar Grid.Column="1"
                                                         Progress="{Binding progresoComp}"
                                                         ProgressColor="#9C8442"
                                                         VerticalOptions="Center"/>
                                            <Label Grid.Column="2"
                                                   Text="{Binding precioComp}"
                                                   FontSize="11"
                                                   TextColor="#9C8442"
                                                   FontAttributes="Bold"/>
                                        </Grid>
                                        <Label Text="{Binding diferencia}"
                                               FontSize="11"
                                               TextColor="{Binding colorDif}"
                                               FontAttributes="Bold"/>
                                        <BoxView HeightRequest="1" Color="#F0F0F0"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>