<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="ProyectoFinalWS.InscripcionesPage"
             Title="Inscripciones"
             BackgroundColor="#F0F2F5">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <StackLayout BackgroundColor="#5B0000" Padding="20,25">
                <Label Text="Inscripciones"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="White"/>
                <Label Text="Análisis y comparación por programa"
                       FontSize="13"
                       HorizontalOptions="Center"
                       TextColor="#D4B483"
                       Margin="0,4,0,0"/>
            </StackLayout>

            <VerticalStackLayout Padding="15" Spacing="12">

                <Border Stroke="#D4B483" BackgroundColor="White"
                        StrokeThickness="1" Padding="15"
                        StrokeShape="roundrectangle 15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Selecciona un programa"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#5B0000"/>
                        <BoxView HeightRequest="1" Color="#E0E0E0"/>
                        <Picker x:Name="pickerPrograma"
                                Title="-- Selecciona un programa --"
                                SelectedIndexChanged="OnProgramaChanged"
                                TextColor="Black"
                                BackgroundColor="#F0F2F5"/>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto"
                      ColumnSpacing="10">
                    <Border Grid.Column="0"
                            Stroke="#D4B483" BackgroundColor="White"
                            StrokeThickness="1" Padding="14"
                            StrokeShape="roundrectangle 15">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Total grupos"
                                   FontSize="11" TextColor="#888"/>
                            <Label x:Name="lblTotalGrupos"
                                   Text="-"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#5B0000"/>
                            <Label Text="Histórico del programa"
                                   FontSize="11" TextColor="#888"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1"
                            Stroke="#D4B483" BackgroundColor="White"
                            StrokeThickness="1" Padding="14"
                            StrokeShape="roundrectangle 15">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Ocupación promedio"
                                   FontSize="11" TextColor="#888"/>
                            <Label x:Name="lblOcupacionPromedio"
                                   Text="-"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#5B0000"/>
                            <Label x:Name="lblSemaforoOcupacion"
                                   Text=""
                                   FontSize="12"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Stroke="#D4B483" BackgroundColor="White"
                        StrokeThickness="1" Padding="15"
                        StrokeShape="roundrectangle 15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Inscritos por grupo"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#5B0000"/>
                        <Label x:Name="lblSubtituloBarras"
                               Text="Selecciona un programa para ver la comparativa"
                               FontSize="11"
                               TextColor="#888"/>
                        <BoxView HeightRequest="1" Color="#E0E0E0"/>
                        <microcharts:ChartView x:Name="chartBarras"
                                              HeightRequest="300"/>
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="#D4B483" BackgroundColor="White"
                        StrokeThickness="1" Padding="15"
                        StrokeShape="roundrectangle 15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Detalle por grupo"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#5B0000"/>
                        <BoxView HeightRequest="1" Color="#E0E0E0"/>
                        <CollectionView x:Name="colecGrupos">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Padding="0,8" Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding fecha_inicio}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   TextColor="#5B0000"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding porcentaje_ocupacion, StringFormat='{0:N1}%'}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   TextColor="#9C8442"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*,*">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="Inscritos"
                                                       FontSize="10" TextColor="#888"/>
                                                <Label Text="{Binding total_inscritos}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="#5B0000"/>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="Egresados"
                                                       FontSize="10" TextColor="#888"/>
                                                <Label Text="{Binding egresados}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="#085041"/>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                                <Label Text="Bajas"
                                                       FontSize="10" TextColor="#888"/>
                                                <Label Text="{Binding bajas}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="#A32D2D"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="#F0F0F0"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="borderRecomendacion"
        Stroke="#9FE1CB"
        BackgroundColor="#EAF9EF"
        StrokeThickness="1"
        Padding="15"
        StrokeShape="roundrectangle 15"
        IsVisible="False">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="💡 Recomendación BI"
               FontAttributes="Bold"
               FontSize="14"
               TextColor="#5B0000"/>
                        <BoxView HeightRequest="1" Color="#E0E0E0"/>
                        <Label x:Name="lblRecomendacion"
               Text=""
               FontSize="12"
               TextColor="#085041"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>